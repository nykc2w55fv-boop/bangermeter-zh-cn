{
  "manifest_version": 3,
  "name": "Bangermeter — X 算法评分（简体中文版）",
  "version": "0.11.0",
  "description": "使用 X 公布的「为你推荐」权重和评分公式评估帖子。每项评分因素均标注来源。",
  "default_locale": "en",
  "permissions": ["storage"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://pro.x.com/*", "https://twitter.com/*"],
      "js": ["weights.js", "scoring.js", "i18n.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bangermeter — X 算法评分"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
